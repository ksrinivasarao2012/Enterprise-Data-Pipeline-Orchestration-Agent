# Copy this file to .env and configure your variables
GOOGLE_API_KEY=your-actual-api-key-here

# Sign in with Google (CHANGES.md section 31). Leave GOOGLE_CLIENT_ID empty to run locally
# without a login. On Vercel all three are required.
#   GOOGLE_CLIENT_ID   - OAuth client id from Google Cloud Console (ends in .apps.googleusercontent.com)
#   EHA_ADMIN_EMAILS   - Google accounts that get admin rights, comma separated
#   EHA_SESSION_SECRET - signs the login cookie; create it with:
#                        python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_CLIENT_ID=
EHA_ADMIN_EMAILS=
EHA_SESSION_SECRET=

# Optional: admin key for scripts only (scripts/measure.py --url). Sent in the X-Access-Key header.
EHA_ADMIN_KEY=
