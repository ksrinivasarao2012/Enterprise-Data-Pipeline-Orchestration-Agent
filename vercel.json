{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "src/api/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,test/**,scratch/**,scripts/**,runbooks/**,venv/**,*.png,*.zip}"
    }
  }
}
